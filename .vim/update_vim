#!/usr/bin/env bash
set -euo pipefail

command -v vim >/dev/null 2>&1 || {
    printf '%s\n' 'Vim is not installed. Install it with your system package manager or use scripts/install_setup.sh --install-system-deps.' >&2
    exit 1
}

printf '%s\n' 'Using the Vim installation already available on this system:'
vim --version | sed -n '1,2p'
printf '%s\n' 'No system packages or editor alternatives were changed.'
